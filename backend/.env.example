# Copy this file to .env (in this backend folder). The backend reads it when it starts.

# Ollama Cloud API key, from https://ollama.com/settings/keys
# With a key set, the backend talks to https://ollama.com directly.
OLLAMA_API_KEY=

# Where Ollama is. Defaults to https://ollama.com when OLLAMA_API_KEY is set,
# otherwise to a local Ollama at http://localhost:11434.
# OLLAMA_BASE_URL=https://ollama.com

# Model to use when none is picked in the UI. It always appears in the model list,
# even if the server does not list it. For example:
# OLLAMA_MODEL=qwen3-vl:235b
